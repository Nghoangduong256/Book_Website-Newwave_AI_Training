# <PROJECT> — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way.
# This file carries NAMES and EXAMPLE values only — never a real secret, not even a dead one.

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=<project>
APP_ENV=local                   # local | ci | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-32-bytes-minimum

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/app

# ── Broker / cache ─────────────────────────────────────────────────────────
BROKER_URL=redis://valkey:6379/0
CACHE_URL=redis://valkey:6379/1
WORKER_CONCURRENCY=4

# ── Object storage ─────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=<project>-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_REGION=ap-northeast-1

# ── Ports (override when another stack already holds one) ──────────────────
API_PORT=8000
FRONTEND_PORT=3000
PROXY_PORT=8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ── AI providers ───────────────────────────────────────────────────────────
# `fake` is the default on purpose: every business rule must be testable with no provider
# configured and no money spent. A real key is needed only for the live checks that say so.
AI_PROVIDER=fake                # fake | anthropic | <other>
AI_MODEL_PRIMARY=claude-opus-5
AI_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
AI_MAX_CONCURRENCY=4
AI_MONTHLY_BUDGET_USD=0         # 0 disables the guard; set it before the first real call
AI_REQUEST_TIMEOUT_SECONDS=120

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# ── Email ──────────────────────────────────────────────────────────────────
EMAIL_TRANSPORT=console         # console | smtp | ses
EMAIL_FROM=no-reply@example.com

# ── Feature flags ──────────────────────────────────────────────────────────
# One line per flag, e.g. FEATURE_BULK_IMPORT=false. Angle-bracket placeholders are kept
# commented out: Compose parses .env itself and refuses the whole file on an illegal name,
# so an uncommented placeholder breaks the entire stack with an unrelated-looking error.
# FEATURE_EXAMPLE=false
