# Development image. The dependency set is baked in and CACHED — that is the whole point:
# `make check` is seconds because of this layer, and a one-off `docker run python:… pip install`
# pays 60-90s before a single check runs (R-W1 §2).
#
# Source is MOUNTED by docker-compose.yml, so an edit is live and no rebuild is needed for code.
# Rebuild when dependencies change (`make lock`).
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first, so a source change does not invalidate this layer.
COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements.txt -r requirements-dev.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
